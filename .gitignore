# This .gitignore file should be placed at the root of your Unity project directory
#
# Based on GitHub's maintained Unity.gitignore template:
# https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files do not need to be committed.
*.blend1
*.blend1.meta

# Memory captures can be large and may contain sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/[Rr]ecordings/

# Uncomment if you wish to ignore the Asset Store Tools plugin.
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin and personal settings.
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio cache directory.
.vs/

# Gradle cache directory.
.gradle/

# Autogenerated IDE solution and project files.
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated meta files for generated artifacts.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports.
sysinfo.txt
mono_crash.*

# Builds and exported packages.
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics-generated file.
crashlytics-build.properties

# Test Runner-generated files.
InitTestScene*.unity*

# Addressables default ignores, before user customizations.
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files.
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes from play mode tests.
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in the Assets folder.
/[Aa]ssets/[Ss]ceneDependencyCache*
